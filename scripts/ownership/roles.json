{
  "$comment": "파일 소유권 규칙 (docs/plan/05_collaboration_architecture.md §5.2). 역할 단위 검사(Claude Code 훅)와 PR 단위 검사(CI ownership-check, M0)가 함께 쓴다. 목적은 에이전트의 실수 방지다.",
  "protected": {
    "$comment": "어떤 역할도 수정할 수 없는 파일. Codex 검수 결과는 Codex만 생성한다.",
    "patterns": [
      "docs/reviews/**/*.codex.md",
      "docs/plan/feedback/**"
    ]
  },
  "shared": {
    "$comment": "참여 역할과 무관하게 모든 역할이 쓸 수 있는 경로 (작업 지시서의 인계 노트).",
    "patterns": [
      "docs/work/*/tasks/**"
    ]
  },
  "pr_common_allow": {
    "$comment": "PR 단위 검사(CI ownership-check)에서 참여 역할과 무관하게 허용하는 경로. 정규식이며 {ID}는 작업 ID를 re.escape한 값으로 치환한다. 판정은 scripts/ownership/pr_common_allow.py. 검수 결과 파일은 새로 추가만 허용하고 기존 파일 수정은 실패로 본다 (협업 §5.2, §6.5).",
    "regex": [
      "^docs/work/[^/]+/tasks/{ID}\\.md$",
      "^docs/reviews/{ID}/[^/]+\\.md$",
      "^docs/plan/feedback/\\d{4}-\\d{2}-\\d{2}_{ID}(_r[1-9]\\d*)?\\.md$"
    ],
    "paired": {
      "pnpm-lock.yaml": "같은 PR에서 package.json이 바뀐 경우만"
    }
  },
  "roles": {
    "orchestrator": {
      "allow": [
        "**"
      ],
      "deny": []
    },
    "backend-dev": {
      "allow": [
        "backend/**",
        "pnpm-lock.yaml"
      ],
      "deny": [
        "backend/**/*.spec.ts",
        "backend/test/**",
        "backend/jest.config.*",
        "backend/Dockerfile"
      ],
      "allow_after_deny": [
        "backend/test/support/**"
      ]
    },
    "frontend-dev": {
      "allow": [
        "frontend/**",
        "pnpm-lock.yaml"
      ],
      "deny": [
        "frontend/**/*.spec.ts",
        "frontend/**/*.spec.tsx",
        "frontend/test/**",
        "frontend/e2e/**",
        "frontend/src/generated/**",
        "frontend/vitest.config.*",
        "frontend/playwright.config.*",
        "frontend/Dockerfile"
      ],
      "allow_after_deny": [
        "frontend/test/support/**"
      ]
    },
    "test-engineer": {
      "allow": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "backend/test/**",
        "frontend/test/**",
        "frontend/e2e/**",
        "scripts/tests/**"
      ],
      "deny": [
        "backend/test/support/**",
        "frontend/test/support/**",
        "backend/test/setup*.ts",
        "frontend/test/setup*.ts"
      ]
    },
    "devops-engineer": {
      "allow": [
        "infra/**",
        ".github/**",
        ".githooks/**",
        ".husky/**",
        "scripts/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "turbo.json",
        ".nvmrc",
        ".gitignore",
        ".prettierrc*",
        ".prettierignore",
        "eslint.config.*",
        "commitlint.config.*",
        "tsconfig*.json",
        "backend/jest.config.*",
        "frontend/vitest.config.*",
        "frontend/playwright.config.*",
        "backend/test/setup*.ts",
        "frontend/test/setup*.ts",
        "backend/Dockerfile",
        "frontend/Dockerfile",
        "backend/.env.example",
        "frontend/.env.example"
      ],
      "deny": [
        "scripts/tests/**"
      ]
    },
    "docs-writer": {
      "$comment": "기획 문서는 '변경 이력' 섹션만 수정한다. 섹션 단위 검사는 훅으로 할 수 없으므로 지시와 Codex 검수로 확인한다.",
      "allow": [
        "docs/work/**",
        "docs/plan/*.md",
        "infra/README.md"
      ],
      "deny": []
    }
  }
}
