# 로컬 Docker Compose(PostgreSQL) 환경변수 (개요 §6, §6-b)
# 이 파일을 infra/.env 로 복사해서 쓴다: cp infra/.env.example infra/.env
# infra/.env 는 커밋하지 않는다. 실제 비밀번호는 .env 에만 적는다.
# 아래 값은 backend/.env 의 DATABASE_URL (postgresql://USER:PASSWORD@localhost:5432/DB) 과 일치해야 한다.

# 데이터베이스 사용자 이름
POSTGRES_USER=jblog
# 데이터베이스 비밀번호 (자리표시자. 복사한 .env 에서 바꾼다)
POSTGRES_PASSWORD=change-me
# 데이터베이스 이름
POSTGRES_DB=jblog
