{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@jblog/frontend#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_INTERNAL_URL", "NEXT_PUBLIC_SITE_URL"]
    },
    "//#lint:root": {},
    "lint": {},
    "//#typecheck:root": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "//#test:root": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@jblog/frontend#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["API_INTERNAL_URL", "NEXT_PUBLIC_SITE_URL"]
    },
    "@jblog/backend#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NODE_ENV", "API_PORT"]
    }
  }
}
