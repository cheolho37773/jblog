# frontend 환경변수 예시.
# 복사해서 frontend/.env.local 로 사용한다. .env.local 은 커밋하지 않는다.
# NEXT_PUBLIC_ 접두어 변수는 브라우저 번들에 포함되어 공개된다. 비밀값을 넣지 않는다.

# 서버 전용: Next 서버가 backend API를 호출하는 내부 주소 (개발 rewrites·서버 fetch).
API_INTERNAL_URL=http://localhost:4000

# 공개: 사이트의 기준 URL (metadataBase, canonical, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
