# 이 파일을 복사해 `backend/.env`로 쓴다 (cp .env.example .env). `.env`는 커밋하지 않는다.
# 비밀값은 이 파일에 넣지 않는다. 새 환경변수는 쓰는 기능이 생길 때 추가한다.

# 실행 환경: development | test | production. production이면 Swagger(/api/docs)가 꺼진다.
NODE_ENV=development

# API 서버 포트 (1~65535 정수)
API_PORT=4000

# PostgreSQL 접속 URL (필수, 기본값 없음). 비밀번호가 들어가므로 실제 값은 backend/.env에만 쓴다.
# 형식: postgresql://{사용자}:{비밀번호}@{호스트}:{포트}/{DB 이름}?schema=public
#   ({ }는 자리표시다. 비밀번호에 특수문자가 있으면 URL 인코딩한다.)
# 로컬(`pnpm db:up`)은 infra/.env의 POSTGRES_USER·POSTGRES_PASSWORD·POSTGRES_DB와 맞춘다:
#   사용자 jblog, 비밀번호 change-me(infra/.env.example 자리표시자), 호스트 localhost, 포트 5432, DB 이름 jblog
DATABASE_URL=
